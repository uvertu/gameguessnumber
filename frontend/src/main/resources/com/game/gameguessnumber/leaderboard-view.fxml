<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.game.gameguessnumber.LeaderboardController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <Label text="%leaderboard.header" textAlignment="CENTER">
        <font>
            <Font size="20.0"/>
        </font>
    </Label>

    <TableView fx:id="tableView" prefWidth="480" prefHeight="260">
        <columns>
            <TableColumn fx:id="rankColumn" text="%leaderboard.rank" prefWidth="80"/>
            <TableColumn fx:id="attemptsColumn" text="%leaderboard.attempts" prefWidth="100"/>
            <TableColumn fx:id="durationColumn" text="%leaderboard.duration" prefWidth="120"/>
            <TableColumn fx:id="dateColumn" text="%leaderboard.date" prefWidth="180"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" text="" wrapText="true" style="-fx-text-fill: #666;"/>

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="%leaderboard.refresh" onAction="#onRefreshClick" prefWidth="140"/>
        <Button text="%leaderboard.back" onAction="#onBackClick" prefWidth="140"/>
    </HBox>
</VBox>
